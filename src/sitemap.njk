---
# Lijst van alle pagina's voor zoekmachines (/sitemap.xml). Wordt vanzelf
# bijgewerkt; niet aanpassen.
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{%- set adres = site.adres | replace(r/\/$/, "") -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}
{%- if not p.data.noindex and p.url and p.url.endsWith("/") %}
  <url><loc>{{ adres }}{{ p.url }}</loc></url>
{%- endif %}
{%- endfor %}
</urlset>
