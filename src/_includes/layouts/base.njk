<!doctype html>
<html lang="nl"{% if page.url == "/" %} data-home{% endif %}{% if site.stijlwisselaar.aan %} data-themas="{% for thema in site.stijlwisselaar.themas %}{{ thema.code }}{% if not loop.last %} {% endif %}{% endfor %}"{% endif %}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {# Paginatitel: "Titel · Naam", of alleen de naam op de homepagina #}
  {# Titel en beschrijving: uit de front matter (title/description), bij een
     retraite uit titel/samenvatting, en anders de gegevens uit site.yaml #}
  {% set paginaTitel = title or titel %}
  <title>{% if paginaTitel %}{{ paginaTitel }} · {% endif %}{{ site.naam }}</title>
  {% set beschrijving = description or samenvatting or site.omschrijving %}
  {% set adres = site.adres | replace(r/\/$/, "") %}
  {% set paginaAdres = adres + page.url %}
  <meta name="description" content="{{ beschrijving }}">
  {% if noindex %}
  <meta name="robots" content="noindex">
  {% else %}
  <link rel="canonical" href="{{ paginaAdres }}">
  {% endif %}

  {# Deelkaart: wat WhatsApp, Instagram, mail e.d. tonen als iemand een link
     deelt. De afbeelding staat in src/images/deelkaart.jpg (1200 × 630). #}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.naam }}">
  <meta property="og:title" content="{{ paginaTitel or site.naam }}">
  <meta property="og:description" content="{{ beschrijving }}">
  <meta property="og:url" content="{{ paginaAdres }}">
  <meta property="og:image" content="{{ adres }}/images/deelkaart.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Een okerkleurige penseelstreek boven groene heuvels">
  <meta property="og:locale" content="nl_NL">
  <meta name="twitter:card" content="summary_large_image">

  {# Icoontjes voor het browsertabblad en het beginscherm van een telefoon #}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#5f6f3e">

  {# Beveiliging: de browser laadt alleen bestanden van deze site zelf
     (geen scripts, stijlen of lettertypes van andere servers). Links naar
     buiten, zoals Google Forms en mailto, blijven gewoon werken. #}
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'inline-speculation-rules'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests">
  <meta name="referrer" content="strict-origin-when-cross-origin">

  {# Lettertypes van de eigen site: Cormorant Garamond (koppen) en
     Source Sans 3 (lopende tekst). Zie src/css/fonts.css. #}
  <link rel="preload" href="/fonts/source-sans-3-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/cormorant-garamond-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/fonts.css">
  {% if site.stijlwisselaar.aan %}
    {# Extra koplettertypes voor de thema's Penseel & papier en Ochtend #}
    <link rel="stylesheet" href="/css/fonts-themas.css">
  {% endif %}

  <link rel="stylesheet" href="/css/style.css">

  {# Klein script dat vóór het tekenen van de pagina draait: laat de CSS
     weten dat JavaScript werkt (voor het mobiele menu) en zet het onthouden
     thema van de stijlwisselaar. Zie src/js/vooraf.js. #}
  <script src="/js/vooraf.js"></script>
  {% if site.stijlwisselaar.aan %}
    <script src="/js/stijlwisselaar.js" defer></script>
  {% endif %}
  <script src="/js/menu.js" defer></script>
  {# Vloeiende overgangen: de browser haalt een pagina van de site alvast op
     als je met de muis op een link blijft staan of erop tikt, zodat de
     overgang niet hapert. Browsers die dit niet kennen, slaan het over. #}
  <script type="speculationrules">
  {"prefetch": [{"where": {"href_matches": "{{ '/' | url }}*"}, "eagerness": "moderate"}]}
  </script>
  {% if page.url == "/" %}<script src="/js/landschap.js" defer></script>{% endif %}
</head>
<body>
  <a class="skip-link" href="#inhoud">Direct naar de inhoud</a>

  {% include "partials/header.njk" %}

  <main id="inhoud">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  {% if site.stijlwisselaar.aan %}
    {% include "partials/stijlwisselaar.njk" %}
    {% include "partials/overgang-penseel.njk" %}
  {% endif %}
</body>
</html>
