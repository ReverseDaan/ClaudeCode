<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {# Paginatitel: "Titel · Naam", of alleen de naam op de homepagina #}
  <title>{% if title %}{{ title }} · {% endif %}{{ site.naam }}</title>
  <meta name="description" content="{{ description or site.omschrijving }}">

  {# Lettertypes: Cormorant Garamond (koppen) en Source Sans 3 (lopende tekst) #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Source+Sans+3:wght@400;600&display=swap">

  <link rel="stylesheet" href="/css/style.css">

  {# Laat de CSS weten dat JavaScript werkt (nodig voor het mobiele menu) #}
  <script>document.documentElement.classList.add("js");</script>
  <script src="/js/menu.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#inhoud">Direct naar de inhoud</a>

  {% include "partials/header.njk" %}

  <main id="inhoud">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}
</body>
</html>
