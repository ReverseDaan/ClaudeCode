{#- De drie stappen van het aanmelden, uit src/_data/praktisch.yaml.
    Gebruik: {% set kort = true %}{% include "partials/aanmeldstappen.njk" %}
    - kort: true = alleen de koppen (op de pagina van een retraite)
    Het cijfer is versiering in een handgetekend rondje; schermlezers lezen
    het nummer al voor omdat het een genummerde lijst (<ol>) is. -#}
<ol class="aanmeldstappen{% if kort %} aanmeldstappen--kort{% endif %}">
  {%- for stap in praktisch.aanmeldstappen %}
  <li class="aanmeldstap">
    <span class="aanmeldstap__cijfer" aria-hidden="true">
      <svg viewBox="0 0 44 44" focusable="false"><path d="M22 3.5c10.6-.4 19 7.6 18.6 18.2-.3 10-8.8 18.7-19 18.3C11.4 39.6 3.3 31.4 3.6 21.6 4 12 11.6 4.2 21 3.6c1.6-.1 3.4.2 4.8.7"/></svg>
      <span>{{ loop.index }}</span>
    </span>
    <span class="aanmeldstap__tekst">
      <strong class="aanmeldstap__kop">{{ stap.kop }}</strong>
      {%- if not kort %}
      {{ stap.tekst }}{% if stap.link %} <a href="{{ stap.link.url }}">{{ stap.link.tekst }}</a>.{% endif %}
      {%- endif %}
    </span>
  </li>
  {%- endfor %}
</ol>
