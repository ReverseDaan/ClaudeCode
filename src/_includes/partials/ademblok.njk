{#- Ademblok op Home (stories 032 en 033). Teksten in src/_data/home.yaml (intro).
    Zonder JavaScript of met "minder beweging" staat er meteen het gewone
    blok: de kop (bijv. "Even uit de drukte") met de tekst.
    Met JavaScript (landschap.js) staat er eerst de ademkop met een cirkel
    die drie keer ademt zodra het blok in beeld komt; daarna verdwijnen die
    twee en verschijnt het gewone blok met de knop "Adem nog een keer".
    De ademkop en de cirkel zijn alleen versiering (aria-hidden); de kop en
    de tekst staan altijd in de pagina, zodat schermlezers ze lezen. -#}
<section class="sectie ademblok" aria-labelledby="intro-kop">
  <div class="container ademblok__binnen">
    <div class="ademblok__podium">
      <div class="ademblok__adem" aria-hidden="true">
        <p class="sectie__kop ademblok__ademkop">{{ home.intro.ademkop }}</p>
        <div class="ademblok__cirkel">
          <span class="ademblok__woord ademblok__woord--in">{{ home.intro.in }}</span>
          <span class="ademblok__woord ademblok__woord--uit">{{ home.intro.uit }}</span>
        </div>
      </div>
      <div class="ademblok__tekst">
        <h2 class="sectie__kop ademblok__kop" id="intro-kop" tabindex="-1">{{ home.intro.kop }}</h2>
        {% for alinea in home.intro.tekst %}<p>{{ alinea }}</p>{% endfor %}
        <p class="ademblok__opnieuw"><button type="button" class="knop knop--rustig ademblok__knop" hidden>{{ home.intro.opnieuw }}</button></p>
      </div>
    </div>
  </div>
</section>
