{# Voettekst op elke pagina. De gegevens komen uit src/_data/site.yaml
   en src/_data/stichting.yaml. #}
<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__naam">{{ site.naam }}</p>
      <p>Retraites over vertragen, creëren en de reis naar binnen.</p>
    </div>

    <nav aria-label="Snelle links">
      <h2 class="site-footer__kop">Snelle links</h2>
      <ul class="kale-lijst">
        {% for item in site.menu %}
          <li><a href="{{ item.url }}">{{ item.tekst }}</a></li>
        {% endfor %}
        <li><a href="/vragen/">Veelgestelde vragen</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="site-footer__kop">Contact</h2>
      <ul class="kale-lijst">
        <li><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></li>
      </ul>

      <h2 class="site-footer__kop site-footer__kop--los">Volg ons</h2>
      <ul class="kale-lijst">
        {% for kanaal in site.social %}
          <li><a href="{{ kanaal.url }}" rel="noopener">{{ kanaal.naam }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  {# Onderste regel: juridische gegevens en links #}
  <div class="container site-footer__onder">
    <p>© {{ jaar }} {{ site.naam }}</p>
    <ul class="site-footer__gegevens kale-lijst">
      {# Zolang er geen echte stichting is, staat er "(voorbeeld)" bij #}
      {% set vb = " (voorbeeld)" if stichting.voorbeeld else "" %}
      <li>KvK: {{ stichting.kvk }}{{ vb }}</li>
      <li>RSIN: {{ stichting.rsin }}{{ vb }}</li>
      <li>Statutaire zetel: {{ stichting.zetel }}{{ vb }}</li>
      {% if stichting.anbi %}<li>ANBI-instelling</li>{% endif %}
      <li><a href="/privacy/">Privacybeleid</a></li>
      <li><a href="/voorwaarden/">Algemene voorwaarden</a></li>
    </ul>
  </div>
</footer>
