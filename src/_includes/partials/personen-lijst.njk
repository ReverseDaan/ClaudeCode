{#- Lijst met kaarten van alle personen uit src/_data/personen.yaml.
    Zet je vooraf personenLijst (bijv. alleen de begeleiders van een
    retraite), dan toont hij alleen die personen.
    Gebruik in een Markdown-pagina op een eigen regel, met een lege regel
    erboven en eronder: {% include "partials/personen-lijst.njk" %}
    Let op: deze uitvoer mag geen lege regels bevatten, anders leest
    Markdown de rest als gewone tekst. Daarom staan er overal streepjes
    in de tags ({%- en -%}): die halen witruimte weg. -#}
<ul class="personen-lijst kale-lijst">
{%- for persoon in (personenLijst if personenLijst else personen) %}
<li class="persoon-kaart">
<div class="persoon-kaart__kop">
{%- if persoon.foto2 and (persoon.foto2 | afbeeldingBestaat) and persoon.foto and (persoon.foto | afbeeldingBestaat) %}
{#- Twee versies (story 041): per opzet is er één zichtbaar (style.css, sectie 19) #}
<img class="persoon-kaart__foto persoon-versie-1" src="/images/{{ persoon.foto }}" alt="Foto van {{ persoon.naam }}" width="160" height="160" loading="lazy">
<img class="persoon-kaart__foto persoon-versie-2" src="/images/{{ persoon.foto2 }}" alt="Foto van {{ persoon.naam }}" width="160" height="160" loading="lazy">
{%- elif persoon.foto and (persoon.foto | afbeeldingBestaat) %}
<img class="persoon-kaart__foto" src="/images/{{ persoon.foto }}" alt="Foto van {{ persoon.naam }}" width="160" height="160" loading="lazy">
{%- else %}
<span class="persoon-kaart__foto persoon-kaart__foto--leeg" aria-hidden="true">{{ persoon.naam | first }}</span>
{%- endif %}
<div class="persoon-kaart__tekst">
<h3 class="persoon-kaart__naam">{{ persoon.naam }}</h3>
<p class="persoon-kaart__rol">{{ persoon.rol }}</p>
</div>
</div>
{%- if persoon.bio2 %}
<p class="persoon-kaart__bio persoon-versie-1">{{ persoon.bio }}</p>
{#- Versie 2 is lang: eerst de eerste alinea, de rest achter "Lees verder"
    (story 043; <details> werkt zonder JavaScript) #}
{%- set alineas = persoon.bio2 | alineas %}
<div class="persoon-kaart__bio persoon-versie-2">
<p>{{ alineas[0] }}</p>
{%- if alineas.length > 1 %}
<details class="lees-verder">
<summary><span class="lees-verder__open">Lees verder</span><span class="lees-verder__dicht">Minder tonen</span></summary>
<div class="lees-verder__rest">
{%- for alinea in alineas %}{% if not loop.first %}
<p>{{ alinea }}</p>
{%- endif %}{% endfor %}
</div>
</details>
{%- endif %}
</div>
{%- else %}
<p class="persoon-kaart__bio">{{ persoon.bio }}</p>
{%- endif %}
</li>
{%- endfor %}
</ul>
