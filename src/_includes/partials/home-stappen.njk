{#- De drie stappen op Home (aankomen, creëren, reflecteren), uit
    src/_data/home.yaml. De iconen zijn zelf getekend in SVG en gebruiken
    de kleuren van het thema. -#}
<ol class="home-stappen kale-lijst">
  {%- for stap in home.stappen.lijst %}
  <li class="home-stap">
    <svg class="home-stap__icoon" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
      {%- if stap.icoon == "aankomen" %}
      {#- een boom op een heuvel -#}
      <path d="M24 8c-5 6-9 12-9 17 0 5 4 8 9 8s9-3 9-8c0-5-4-11-9-17z"/>
      <path d="M24 20v20"/>
      <path d="M5 41c8-3 16-4 19-4s12 1 19 4"/>
      {%- elif stap.icoon == "creeren" %}
      {#- een penseel met een streek -#}
      <path d="M33 7l8 8-15 15-6 1 1-6z"/>
      <path d="M20 31c-3 0-6 2-7 5-1 3-3 5-6 5 5 2 11 1 13-3 1-2 1-5 0-7"/>
      {%- else %}
      {#- een spiraal naar binnen -#}
      <path d="M24 24c0-2 2-3 3.5-2s1.5 4-1 5.5-6 0-7-3.5 1.5-8 6-8.5 9 3 9.5 8-3 11-9 11.5-12-3.5-12.5-10S14 9 22 8.5s16 4 17 11"/>
      {%- endif %}
    </svg>
    <h3 class="home-stap__kop">{{ stap.kop }}</h3>
    <p class="home-stap__tekst">{{ stap.tekst }}</p>
  </li>
  {%- endfor %}
</ol>
