      <ellipse cx="460" cy="430" rx="100" ry="90" fill="#c08a52"/>
      <ellipse cx="340" cy="420" rx="80" ry="70" fill="#b57c46"/>
      <path fill="#7a4f30" d="M200 880l4-150 10 0-2 150z"/>
      <ellipse cx="208" cy="690" rx="70" ry="58" fill="#b9814b"/>
      <path fill="#9b5f37" opacity="0.9" d="M60 880c20-40 60-60 100-60s60 30 90 30 60-30 110-30 80 30 120 30 80-20 120-10V900H60z"/>
      <path class="landschap__grond-voor" d="M40 850c180-20 360-20 560-6V900H40z"/>
    </g>

    <g class="landschap__thema landschap__thema--penseel">
      {#- bomen als losse penseeltoetsen: stammen in inkt, kronen als korte,
          dikke toetsen in groen, blauw en een vleugje rood en geel -#}
      <g fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path stroke="#1f2340" stroke-width="15" d="M430 860c-4-110 8-230-2-360"/>
        <path stroke="#1f2340" stroke-width="6" d="M428 620c26-24 52-36 80-40M430 700c-26-20-50-30-78-32M428 540c-22-18-40-26-62-28"/>
        <path stroke="#3e8a5c" stroke-width="46" opacity="0.9" d="M360 470l40-30M420 420l50-24M470 470l46-14M380 380l44-30M450 350l40-16M500 410l36-6M340 540l40-10M410 500l52-8M480 540l40 0"/>
        <path stroke="#2d3fa8" stroke-width="34" opacity="0.75" d="M350 430l30-26M430 460l40-14M500 380l30-14M400 330l34-18M460 520l34-4"/>
        <path stroke="#f2b33d" stroke-width="16" opacity="0.95" d="M470 400l18-6M380 500l16-4"/>
