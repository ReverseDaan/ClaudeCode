      <path class="landschap__grond-voor" d="M0 300c200-22 400 10 620-2 220-12 420-18 820 4V360H0z"/>
    </g>
  </svg>

  {#- 3. Bomen aan de rechterkant -#}
  <svg class="landschap__laag landschap__bomen" data-diepte="-0.08" viewBox="0 0 600 900" preserveAspectRatio="xMaxYMax meet" focusable="false">
    <g class="landschap__thema landschap__thema--bos">
      {#- dennen: stam en drie lagen takken -#}
      <g fill="#1a2412">
        <rect x="430" y="520" width="18" height="360"/>
        <path d="M439 120l120 220h-60l100 170h-70l90 150H299l90-150h-70l100-170h-60z"/>
      </g>
      <g fill="#24321a">
        <rect x="270" y="610" width="14" height="270"/>
        <path d="M277 300l92 170h-46l78 130h-54l70 120H137l70-120h-54l78-130h-46z"/>
      </g>
      <g fill="#2f4122">
        <rect x="548" y="660" width="12" height="220"/>
        <path d="M554 420l70 130h-36l60 100h-42l54 92H448l54-92h-42l60-100h-36z"/>
      </g>
      <g fill="#3a4f2a" opacity="0.9">
        <rect x="164" y="720" width="10" height="160"/>
        <path d="M169 540l54 100h-28l46 76h-32l40 70H89l40-70H97l46-76h-28z"/>
      </g>
      <path class="landschap__grond-voor" d="M40 846c180-22 360-22 560-6V900H40z"/>
    </g>

    <g class="landschap__thema landschap__thema--zand">
      {#- losse loofbomen op de heide -#}
      <path fill="#6b4529" d="M402 880l6-250c-30-30-60-40-90-44 34-4 64 6 88 26l4-90 14 2-4 110c22-26 50-40 80-44-28 14-52 34-70 60l-4 230z"/>
