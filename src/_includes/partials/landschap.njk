{#- Getekend landschap achter de hero op Home: lucht, pad en bomen.
    Elke stijl (thema) heeft een eigen tekening; de CSS toont alleen die van
    het actieve thema (zie style.css, sectie "Landschap").
    Drie lagen, zodat ze op mobiel en desktop los van elkaar passen:
     1. lucht en verre heuvels (vult de hele hero)
     2. pad en grond (onderaan, het pad loopt het landschap in)
     3. bomen (rechts)
    Alles is versiering: schermlezers slaan het over. -#}
<div class="landschap" aria-hidden="true">

  {#- 1. Lucht en verre heuvels -#}
  <svg class="landschap__laag landschap__lucht" data-diepte="0.15" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" focusable="false">
    <defs>
      <linearGradient id="lucht-bos" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#1f2a17"/><stop offset="0.55" stop-color="#3d4a26"/><stop offset="1" stop-color="#7a6a3a"/>
      </linearGradient>
      <linearGradient id="lucht-zand" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#f6e3c4"/><stop offset="0.6" stop-color="#efc99a"/><stop offset="1" stop-color="#e2a86e"/>
      </linearGradient>
      <linearGradient id="lucht-penseel" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#f6f0e4"/><stop offset="1" stop-color="#f3e6cf"/>
      </linearGradient>
      <linearGradient id="lucht-ochtend" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#d9e9ef"/><stop offset="0.55" stop-color="#fbe7dc"/><stop offset="1" stop-color="#fcd9c4"/>
      </linearGradient>
    </defs>

    <g class="landschap__thema landschap__thema--bos">
      <rect width="1440" height="900" fill="url(#lucht-bos)"/>
      <circle cx="430" cy="610" r="150" fill="#d9b066" opacity="0.18"/>
      <path fill="#2c3a1c" opacity="0.8" d="M0 560c110-40 210-28 320-50 120-24 220-2 340-28 130-28 240 6 380-18 150-26 260 6 400-22V900H0z"/>
      {#- verre dennetjes op de heuvel links -#}
      <g fill="#2c3a1c">
        <path d="M120 548l18 40h-9l15 28H90l15-28h-9z"/><path d="M160 540l22 48h-11l18 34H120l18-34h-11z"/>
        <path d="M205 552l16 36h-8l13 24h-42l13-24h-8z"/><path d="M300 520l20 44h-10l16 30h-52l16-30h-10z"/>
        <path d="M335 530l15 34h-7l12 22h-40l12-22h-7z"/>
      </g>
      <path fill="#23301a" d="M0 640c140-30 260 4 400-14 150-20 260 10 420-6 160-16 300 14 620-18V900H0z"/>
    </g>

    <g class="landschap__thema landschap__thema--zand">
      <rect width="1440" height="900" fill="url(#lucht-zand)"/>
      <circle cx="560" cy="560" r="120" fill="#fff4dc" opacity="0.7"/>
      <path fill="#d99a62" opacity="0.55" d="M0 600c160-60 300-50 460-30 170 22 300-40 480-36 180 4 300 40 500 10V900H0z"/>
      <path fill="#c4834f" opacity="0.75" d="M0 660c200-30 360 10 540-4 170-14 330-30 500-6 150 20 260 4 400-6V900H0z"/>
    </g>

    <g class="landschap__thema landschap__thema--penseel">
      <rect width="1440" height="900" fill="url(#lucht-penseel)"/>
      {#- waterverfvlekken in de lucht, weg van de tekst -#}
      <path fill="#2d3fa8" opacity="0.13" d="M1040 60c110-40 250-30 330 20 60 38 40 100-40 120-120 30-260 10-320-40-40-34-20-80 30-100z"/>
      <path fill="#2d3fa8" opacity="0.09" d="M-40 120c100-40 220-30 280 10 50 34 20 80-50 90-90 14-190-10-230-50z"/>
      <path fill="#f2b33d" opacity="0.3" d="M160 470c60-60 190-70 260-20 64 46 34 124-56 140-100 18-250-40-204-120z"/>
      <path fill="#d9482b" opacity="0.12" d="M1100 330c70-30 160-14 190 34 24 40-30 72-104 72-80 0-136-64-86-106z"/>
      <path fill="#3e8a5c" opacity="0.32" d="M0 610c120-50 250-40 380-20 150 24 260-30 420-26 170 4 300 50 640 6V900H0z"/>
      <path fill="#2d3fa8" opacity="0.22" d="M0 650c160-24 330 16 500 2 180-14 320-24 480-4 170 22 300 0 460-10V900H0z"/>
    </g>

    <g class="landschap__thema landschap__thema--ochtend">
      <rect width="1440" height="900" fill="url(#lucht-ochtend)"/>
      <circle cx="520" cy="590" r="110" fill="#ffd2b3"/>
      <circle cx="520" cy="590" r="170" fill="#ffd9c0" opacity="0.45"/>
      <path fill="#a9c4c4" opacity="0.55" d="M0 600c140-40 270-30 400-14 150 18 260-26 420-24 170 2 300 34 620-2V900H0z"/>
