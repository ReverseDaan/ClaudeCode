        <path stroke="#1f2340" stroke-width="10" d="M230 860c2-70-6-140 2-230"/>
        <path stroke="#3e8a5c" stroke-width="36" opacity="0.85" d="M180 650l30-18M230 620l36-12M260 670l30-8M200 700l34-6"/>
        <path stroke="#2d3fa8" stroke-width="26" opacity="0.7" d="M210 670l24-10M250 710l22-4"/>

        <path stroke="#1f2340" stroke-width="9" d="M560 860c2-60-4-120 2-190"/>
        <path stroke="#2d3fa8" stroke-width="32" opacity="0.8" d="M520 700l26-14M560 670l30-10M580 720l20-4"/>
        <path stroke="#3e8a5c" stroke-width="26" opacity="0.8" d="M540 740l26-6"/>
      </g>
      <path class="landschap__grond-voor" d="M40 846c180-22 360-22 560-6V900H40z"/>
    </g>

    <g class="landschap__thema landschap__thema--ochtend">
      {#- berken in de ochtendnevel: witte stammen met donkere vlekjes en
          lichte, luchtige kronen -#}
      <g fill="#f7f1ea" stroke="#9aa6a4" stroke-width="1.5">
        <path d="M412 860l8-640 14 0 6 640z"/>
        <path d="M282 860l6-470 11 0 4 470z"/>
        <path d="M538 860l5-380 9 0 4 380z"/>
      </g>
      <g fill="#46505a">
        <path d="M414 330h12v6h-12zM424 440h14v5h-14zM412 560h10v6h-10zM426 680h12v5h-12zM416 790h14v6h-14z"/>
        <path d="M284 520h10v5h-10zM292 640h10v4h-10zM282 760h12v5h-12z"/>
        <path d="M542 600h8v4h-8zM548 720h8v4h-8z"/>
      </g>
      <g stroke="#7d8f86" stroke-width="3" fill="none" stroke-linecap="round">
        <path d="M426 300c-30-30-60-40-90-40M430 260c30-34 64-44 96-40M298 430c-24-20-48-28-70-26M548 500c20-18 40-24 58-22"/>
