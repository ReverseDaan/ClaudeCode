---
layout: layouts/base.njk
---
{# Homepagina. De teksten staan in src/_data/home.yaml. #}

{# Gegevens over de organisatie, voor zoekmachines #}
<script type="application/ld+json">
{{ site | organisatieGegevens | jsonLd | safe }}
</script>

{# 1. Hero: getekend landschap (per thema) met naam, slogan en knop.
   Staat er een foto in src/images/ (home.yaml), dan toont de hero die. #}
<section class="hero">
  {% if home.hero.afbeelding | afbeeldingBestaat %}
  <img class="hero__foto" src="/images/{{ home.hero.afbeelding }}" alt="{{ home.hero.alt }}" fetchpriority="high">
  {% endif %}
  {% include "partials/landschap.njk" %}
  <div class="container hero__inhoud">
    {# De naam als tekening (wordt "geschreven", zie landschap.js); voor
       schermlezers en zoekmachines staat de gewone tekst ernaast. #}
    <h1 class="hero__titel">
      <span class="sr-only">{{ site.naam }}</span>
      <svg class="hero__naam" aria-hidden="true" focusable="false"><text x="50%" y="1em" text-anchor="middle">{{ site.naam }}</text></svg>
    </h1>
    <svg class="hero__streek" viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path pathLength="1" d="M6 13c40-6 80-9 124-8 50 1 96 5 164-3"/></svg>
    <p class="hero__slogan">{{ home.hero.slogan }}</p>
    <a class="knop" href="/kalender/">{{ home.hero.knop }}</a>
  </div>

</section>

{# 2. Ademblok: even meeademen, daarna de introductietekst (home.yaml, intro) #}
{% include "partials/ademblok.njk" %}

{# 3. Drie stappen: aankomen, creëren, reflecteren #}
<section class="sectie sectie--zand" aria-labelledby="stappen-kop">
  <div class="container">
    <h2 class="sectie__kop" id="stappen-kop">{{ home.stappen.kop }}</h2>
    {% include "partials/home-stappen.njk" %}
  </div>
</section>

{# 4. Eerstvolgende retraite: de eerste retraite met een datum in de toekomst #}
{% set eerstvolgende = collections.komendeRetraites[0] %}
<section class="sectie" aria-labelledby="eerstvolgende-kop">
  <div class="container">
    <h2 class="sectie__kop" id="eerstvolgende-kop">{{ home.eerstvolgende.kop }}</h2>
    {% if eerstvolgende %}
      <div class="home-eerstvolgende">
        {% set retraite = eerstvolgende %}{% set knop = "aanmelden" %}{% set knopLabel = home.eerstvolgende.knop %}
        {% include "partials/retraite-kaart.njk" %}
      </div>
    {% elif site.interesselijst.url %}
      <p class="retraite-leeg">{{ home.eerstvolgende.leeg }}</p>
      {% include "partials/interesselijst.njk" %}
    {% else %}
      <p class="retraite-leeg">{{ home.eerstvolgende.leeg }} <a href="/contact/">{{ home.eerstvolgende.leegLink }}</a>.</p>
    {% endif %}
  </div>
</section>

{% include "partials/penseelstreek.njk" %}

{# 5. Ervaringen van deelnemers (src/_data/ervaringen.yaml) #}
{% if ervaringen and ervaringen.length %}
<section class="sectie" aria-labelledby="ervaringen-kop">
  <div class="container">
    <h2 class="sectie__kop" id="ervaringen-kop">{{ home.ervaringen.kop }}</h2>
    {% include "partials/ervaringen.njk" %}
  </div>
</section>
{% endif %}

{% include "partials/penseelstreek.njk" %}

{# 6. Drie routes naar de rest van de site #}
<section class="sectie" aria-labelledby="routes-kop">
  <div class="container">
    <h2 class="sectie__kop" id="routes-kop">{{ home.routes.kop }}</h2>
    <ul class="home-routes kale-lijst">
      {% for route in home.routes.lijst %}
      <li><a class="home-route" href="{{ route.url }}"><span class="home-route__kop">{{ route.kop }}</span><span class="home-route__tekst">{{ route.tekst }}</span></a></li>
      {% endfor %}
    </ul>
  </div>
</section>

{# 7. Houd me op de hoogte (alleen als de link in site.yaml staat; staat hij
   al bij "Eerstvolgende retraite" omdat er niets gepland is, dan niet nog eens) #}
{% if site.interesselijst.url and eerstvolgende %}
<section class="sectie sectie--compact">
  <div class="container">
    {% include "partials/interesselijst.njk" %}
  </div>
</section>
{% endif %}

